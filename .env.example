# Datenbank (MySQL, Hostinger Remote-Zugriff)
# Format: mysql://BENUTZER:PASSWORT@HOST:3306/DATENBANK
DATABASE_URL="mysql://user:password@srvXXXX.hstgr.io:3306/lts_website"

# Auth.js (Admin-Panel unter /admin)
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Admin-Benutzer (wird von `npm run db:seed` angelegt, Passwort mind. 12 Zeichen)
ADMIN_EMAIL="admin@ltslogistik.de"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""

# SMTP (Benachrichtigungen bei neuen Anfragen und Bewerbungen)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@ltslogistik.de"
SMTP_PASSWORD=""
EMAIL_FROM="LTS Logistik <noreply@ltslogistik.de>"
# Interne Empfänger für Benachrichtigungen
EMAIL_INTERNAL_INQUIRIES="info@ltslogistik.de"
EMAIL_INTERNAL_HR="info@ltslogistik.de"

# S3-kompatibler Object Storage (MEGA S4 / MinIO / AWS S3)
# - S3_BUCKET_APPLICATIONS: privater Bucket für Bewerbungsunterlagen
# - S3_BUCKET_MEDIA: Bucket für Editor-Bilder/-Videos. Sobald gesetzt, landen
#   alle Uploads aus dem Seiten-Editor hier. MEGA S4 erlaubt keine öffentlichen
#   Buckets, daher liefert die App die Dateien über die Proxy-Route
#   /api/media/<key> aus (kein lokaler /uploads-Ordner nötig).
# Endpoint/Region exakt aus dem MEGA-S4-Panel übernehmen (z.B.
# https://s3.eu-amsterdam.megas4.com, Region eu-amsterdam).
S3_ENDPOINT="https://s3.eu-central-1.s4.mega.io"
S3_REGION="eu-central-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_APPLICATIONS="lts-applications"
S3_BUCKET_MEDIA="lts-media"
# Nur setzen, wenn ein echter ÖFFENTLICHER CDN-Storage genutzt wird
# (z.B. Cloudflare R2, BunnyCDN). Dann werden direkte URLs statt der Proxy-Route
# verwendet. Bei MEGA S4 leer lassen.
S3_PUBLIC_URL=""

# CAPTCHA (selbst gehostetes Cap / capjs). Optional: sobald gesetzt, ersetzt es
# die Zeitfalle in allen Formularen. Werte aus dem Cap-Dashboard.
# - NEXT_PUBLIC_CAP_API_ENDPOINT: Widget-Endpoint (enthält den Site-Key,
#   endet mit "/"), z.B. https://cap.ltslogistik.de/<siteKey>/
# - CAP_VERIFY_URL: serverseitige Prüf-URL, meist <endpoint>siteverify
# - CAP_SECRET: geheimer Schlüssel (NICHT der Dashboard-Admin-Key)
NEXT_PUBLIC_CAP_API_ENDPOINT=""
CAP_VERIFY_URL=""
CAP_SECRET=""

# Mapbox (Europakarte, Phase 5)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Analytics (werden nur nach Cookie-Einwilligung geladen)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_MATOMO_URL=""
NEXT_PUBLIC_MATOMO_SITE_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
